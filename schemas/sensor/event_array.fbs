include "../common/header.fbs";

namespace vmsgs.fbs.sensor;

/// Single async event from an event camera (DVS).
struct Event {
  /// Pixel coordinates.
  x:uint16;
  y:uint16;  // Zero-based pixel row from the image upper edge.
  /// Polarity: 0 = OFF (dimming), 1 = ON (brightening).
  polarity:ubyte;
  /// Reserved padding byte kept after polarity for alignment and future use.
  reserved:ubyte;
  /// Timestamp delta (ns) relative to header.stamp.
  delta_ns:uint32;
}

/// Burst of event-camera events.
table EventArray {
  header:vmsgs.fbs.common.Header (id: 0);  // Batch time in nanoseconds and optical frame.
  height:uint32 (id: 1);  // Event-sensor pixel rows.
  width:uint32 (id: 2);  // Event-sensor pixel columns.
  events:[Event] (id: 3);  // Events ordered by nondecreasing timestamp offset.
}

root_type EventArray;
