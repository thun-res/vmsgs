include "../common/header.fbs";

namespace vmsgs.fbs.sensor;

/// `format` examples: "jpeg", "png", "webp", "rgb8; jpeg compressed bgr8".
table CompressedImage {
  header:vmsgs.fbs.common.Header (id: 0);  // Original capture time and optical frame.
  format:string (id: 1);  // Codec and source encoding, for example jpeg or png.
  data:[uint8] (id: 2);  // Complete encoded image byte stream.
}

root_type CompressedImage;
