include "../common/header.fbs";

namespace vmsgs.fbs.sensor;

/// A single encoded video frame (e.g. H.264 NAL unit / H.265 / AV1 / VP9).
/// `format` is one of "h264", "h265", "av1", "vp9".
table CompressedVideo {
  /// Capture timestamp and optical frame identifier.
  header:vmsgs.fbs.common.Header (id: 0);

  /// Codec name such as "h264", "h265", "av1", or "vp9".
  format:string (id: 1);

  /// True when this frame is independently decodable.
  is_keyframe:bool (id: 2);

  /// Presentation timestamp as unsigned nanoseconds on the codec time base.
  time_pts:uint64 (id: 3);

  /// Decode timestamp as unsigned nanoseconds on the codec time base.
  time_dts:uint64 (id: 4);

  /// Complete encoded access unit or codec packet bytes.
  data:[uint8] (id: 5);
}

root_type CompressedVideo;
