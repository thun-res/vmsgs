/// Transport metadata shared by zero-copy and high-rate FlatBuffers payloads.
/// Absolute timestamps are direct unsigned nanoseconds; no nested Time object is
/// used, so readers can access timing metadata without an extra indirection.
namespace vmsgs.fbs.common;

/// Header metadata attached to one transported payload.
table Header {
  /// Publisher-assigned sequence number, monotonically increasing per stream.
  seq:uint64 (id: 0);

  /// Coordinate frame in which the payload is expressed, such as "map".
  frame_id:string (id: 1);

  /// Source acquisition or measurement time in nanoseconds.
  stamp:uint64 (id: 2);

  /// Time the message entered the transport in nanoseconds; may equal stamp.
  publish_stamp:uint64 (id: 3);
}
