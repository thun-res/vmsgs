include "../common/header.fbs";

namespace vmsgs.fbs.perception;

/// Per-pixel class id (and optional confidence) image. Tightly packed row-major.
enum SemanticEncoding : ubyte {
  CLASS_ID_UINT8  = 0,
  CLASS_ID_UINT16 = 1,
  CLASS_ID_UINT32 = 2,
}

/// Per-pixel semantic labels and optional confidence for one image frame.
table SemanticImage {
  /// Image acquisition timestamp in nanoseconds and optical frame.
  header:vmsgs.fbs.common.Header (id: 0);
  /// Image height in pixels.
  height:uint32 (id: 1);
  /// Image width in pixels.
  width:uint32 (id: 2);
  /// Scalar class-ID representation used by data.
  encoding:SemanticEncoding (id: 3);
  /// Number of payload bytes between consecutive image rows.
  step:uint32 (id: 4);
  /// Row-major label bytes; size must agree with height, step, and encoding.
  data:[uint8] (id: 5);
  /// Optional confidence map, same dims, float32 row-major.
  confidence:[float] (id: 6);
  /// Class id -> human-readable name (length = number of classes).
  class_names:[string] (id: 7);
}

root_type SemanticImage;
