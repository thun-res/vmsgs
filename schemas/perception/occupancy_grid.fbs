include "../common/header.fbs";
include "../geometry/geometry.fbs";

namespace vmsgs.fbs.perception;

/// 2D rolling/dynamic occupancy grid (zero-copy). See map.OccupancyGridMap for the
/// static map tile and map.OccupancyGrid (proto) for RPC/incremental use.
/// Cell value semantics:
///   -1   unknown
///    0   free
///   100  occupied (linearly mapped in between).
table OccupancyGrid {
  /// Grid generation timestamp in nanoseconds and map coordinate frame.
  header:vmsgs.fbs.common.Header (id: 0);
  /// Map resolution in m/cell.
  resolution:float (id: 1);
  /// Number of columns along the grid x axis.
  width:uint32 (id: 2);
  /// Number of rows along the grid y axis.
  height:uint32 (id: 3);
  /// Origin of cell (0,0) in `header.frame_id`.
  origin:vmsgs.fbs.geometry.Pose (id: 4);
  /// Row-major, length width*height.
  data:[byte] (id: 5);
}

root_type OccupancyGrid;
